# Copy to F:\random_food\.env. Keep the real .env out of Git.
POSTGRES_DB=foodmatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=foodmatch;Username=postgres;Password=postgres
JwtSettings__Secret=replace_with_a_random_secret_of_at_least_32_bytes
JwtSettings__Issuer=FoodMatchApi
JwtSettings__Audience=FoodMatchClient
Cors__Origins=http://localhost:5173
ASPNETCORE_URLS=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development
VITE_API_URL=http://localhost:5000
VITE_SIGNALR_URL=http://localhost:5000
# Optional exact HTTPS origins for dish images, comma-separated (also added to Vercel CSP).
VITE_FOOD_IMAGE_ORIGINS=
# Development may leave Turnstile empty; Production requires real dashboard keys.
# Hostname accepts exact production/staging names separated by commas; no scheme, port or wildcard.
Turnstile__SecretKey=
Turnstile__Hostname=
VITE_TURNSTILE_SITE_KEY=
# Optional client-visible Google Maps Embed API key. Restrict it to this site's HTTP referrers
# and the Maps Embed API; without it, the iframe uses the existing map fallback.
GoogleMaps__EmbedApiKey=
# Optional OSM list. Leave unset to use Google Maps only in every environment.
# Set only an approved dedicated HTTPS interpreter endpoint; the public default is rejected.
# MeetingPlaces__OverpassUrl=https://your-approved-overpass.example/interpreter

# Optional development integrations
STITCH_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
VERCEL_API_TOKEN=
